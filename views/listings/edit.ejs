<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderlust</title>
</head>
<body>
    <!-- Pre-fill the form with the existing listing so its fields can be updated. -->
    <h3>Edit your listings</h3>
       <!-- method-override converts the browser POST into a PUT request. -->
       <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input name="listing[title]" value="<%= listing.title %>" type="text" required>
        <br><br>
        <textarea name="listing[description]"><%= listing.description %></textarea>
        <br><br>
        <input name="listing[image][url]" value="<%= listing.image %>" type="text">
        <br><br>
        <input name="listing[price]"  value="<%= listing.price %>"" type="number">
        <br><br>
        <input name="listing[country]"  value="<%= listing.country %>" type="text">
        <br><br>
        <input name="listing[location]"  value="<%= listing.location %>" type="text">
        <br><br>
        <button>edit</button>
    </form>
</body>
</html>