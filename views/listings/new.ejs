<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderlust</title>
</head>
<body>
    <!-- Listing creation form; nested names become req.body.listing in Express. -->
       <!-- Submit the new listing fields to the POST /listings route. -->
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="enter title" type="text" required>
        <br><br>
        <textarea name="listing[description]" placeholder="enter description"></textarea>
        <br><br>
        <input name="listing[image][url]" placeholder="enter image url" type="text">
        <br><br>
        <input name="listing[price]" placeholder="enter price" type="number">
        <br><br>
        <input name="listing[country]" placeholder="enter country" type="text">
        <br><br>
        <input name="listing[location]" placeholder="enter location" type="text">
        <br><br>
        <button>Add</button>
    </form>
</body>
</html>