<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderlust</title>
</head>
<body>
    <h3>Create a new listing</h3>
    <form action="/listings">
        <input type="listing[title]" placeholder="enter title">
        <br><br>
        <textarea name="listing[description]" placeholder="enter description"></textarea>
        <br><br>
        <input type="listing[image]" placeholder="enter image url" type="text"/>
        <br><br>
        <input type="listing[price]" placeholder="enter price" type="number"/>
        <br><br>
        <input type="listing[country]" placeholder="enter country"type="text"/>
        <br><br>
        <input type="listing[location]" placeholder="enter location" type="text"/>
        <br><br>
        <button>Add</button>
    </form>
</body>
</html>