<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wonderlust</title>
</head>
<body>
    <!-- Show the selected listing fields and link to its edit page. -->
    <h3>Listing details </h3>
    <!-- EJS expressions insert values from the listing loaded by the show route. -->
    <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#x20B9;<%= listing.price.toLocaleString("en-IN") %></li>
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
    </ul>
    <br>
    <a href="/listings/<%= listing.id %>/edit">edit this listing</a>
</body>
</html>